+TEST(JsonParseAsyncInputStorageBounds) {
+  for (bool wide : {false, true}) {
+    const size_t threshold = (1024 * 1024) / (wide ? 2 : 1);
+    for (size_t length : {size_t{0}, size_t{1}, threshold - 1, threshold,
+                          threshold + 1, threshold * 2 + 17}) {
+      i::BackgroundJsonData data(false);
+      data.is_one_byte = !wide;
+      for (int repeat = 0; repeat < 2; ++repeat) {
+        data.AllocateInput(length);
+        const size_t bytes = length * (wide ? 2 : 1);
+        CHECK_GE(data.InputMemoryUsage(), bytes);
+        CHECK_LT(data.InputMemoryUsage() - bytes, size_t{1024 * 1024});
+        if (wide) {
+          auto input = data.Input<uint16_t>();
+          CHECK_EQ(input.size(), length);
+          for (size_t index = 0; index < length; ++index)
+            input[index] = static_cast<uint16_t>(index * 31 + 0x6f22);
+          for (size_t index = 0; index < length; ++index)
+            CHECK_EQ(input[index], static_cast<uint16_t>(index * 31 + 0x6f22));
+        } else {
+          auto input = data.Input<uint8_t>();
+          CHECK_EQ(input.size(), length);
+          for (size_t index = 0; index < length; ++index)
+            input[index] = static_cast<uint8_t>(index * 17 + 5);
+          for (size_t index = 0; index < length; ++index)
+            CHECK_EQ(input[index], static_cast<uint8_t>(index * 17 + 5));
+        }
+        data.ReleaseInput();
+        CHECK_EQ(data.InputMemoryUsage(), 0);
+        CHECK_EQ(data.Input<uint8_t>().size(), 0);
+        CHECK_EQ(data.Input<uint16_t>().size(), 0);
+        data.ReleaseInput();
+      }
+    }
+  }
+}
+
+TEST_WITH_PLATFORM(JsonParseAsyncLargeQueuedInputOutlivesIsolate,
+                   JsonTestPlatform) {
+  for (bool wide : {false, true}) {
+    v8::Isolate::CreateParams params;
+    params.array_buffer_allocator = CcTest::array_buffer_allocator();
+    auto isolate = v8::Isolate::New(params);
+    auto runner = platform.HoldTasks(isolate);
+    auto gate = std::make_shared<JsonWorkerGate>();
+    {
+      v8::Isolate::Scope isolate_scope(isolate);
+      v8::HandleScope scope(isolate);
+      auto context = v8::Context::New(isolate);
+      v8::Context::Scope context_scope(context);
+      platform.SetWorkerGate(gate);
+      CompileRun(wide ? "JSON.parseAsync('\"' + '\\u6f22'.repeat(600000) + '\"')"
+                      : "JSON.parseAsync('\"' + 'x'.repeat(1200000) + '\"')");
+      platform.SetWorkerGate(nullptr);
+      CHECK(gate->arrived.WaitFor(v8::base::TimeDelta::FromSeconds(5)));
+      CHECK(isolate->HasPendingBackgroundTasks());
+    }
+    isolate->Dispose();
+    gate->proceed.Signal();
+    CHECK(gate->finished.WaitFor(v8::base::TimeDelta::FromSeconds(5)));
+    CHECK(!runner->RunOne());
+  }
+}
