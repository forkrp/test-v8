+void BackgroundJsonData::AllocateInput(size_t length) {
+  DCHECK_EQ(InputMemoryUsage(), 0);
+#if defined(V8_OS_ANDROID)
+  const size_t bytes = length * (is_one_byte ? 1 : sizeof(uint16_t));
+  if (bytes >= 1024 * 1024) {
+    // A job owns these pages until all its parsing workers have joined.
+    // Returning a large copy directly avoids native allocator reclamation
+    // work on the completion path. Small copies retain the existing allocator.
+    base::PageAllocator allocator;
+    const size_t page_size = allocator.AllocatePageSize();
+    input_mapped_bytes_ = RoundUp(bytes, page_size);
+    input_pages_ = AllocatePages(&allocator, nullptr, input_mapped_bytes_,
+                                 page_size, PageAllocator::kReadWrite);
+    if (!input_pages_) {
+      V8::FatalProcessOutOfMemory(nullptr, "BackgroundJsonInput");
+    }
+    input_units_ = length;
+    return;
+  }
+#endif
+  if (is_one_byte) {
+    one_byte = base::OwnedVector<uint8_t>::NewForOverwrite(length);
+  } else {
+    two_byte = base::OwnedVector<uint16_t>::NewForOverwrite(length);
+  }
+}
+
+void BackgroundJsonData::ReleaseInput() {
+  one_byte = base::OwnedVector<uint8_t>();
+  two_byte = base::OwnedVector<uint16_t>();
+#if defined(V8_OS_ANDROID)
+  if (input_pages_) {
+    base::PageAllocator allocator;
+    FreePages(&allocator, input_pages_, input_mapped_bytes_);
+    input_pages_ = nullptr;
+    input_mapped_bytes_ = input_units_ = 0;
+  }
+#endif
 }
 
