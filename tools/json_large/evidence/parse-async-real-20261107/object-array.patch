+  static ParseArrayResult Parse(void* context, uint32_t* position,
+                               BackgroundJsonNode* node) {
+    auto& self = *static_cast<RootObjectArray*>(context);
+    if (self.selected || self.input.size() - *position < 4 * 1024 * 1024 ||
